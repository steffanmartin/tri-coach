# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
COACH_MODEL=claude-sonnet-5
PLANNER_MODEL=claude-opus-5

# --- intervals.icu ---
# Settings -> Developer Settings -> API Key
INTERVALS_API_KEY=...
INTERVALS_ATHLETE_ID=i123456

# --- Google (Fitbit Air -> HRV / resting HR / sleep / steps; calendar read) ---
# Coros supplies activities only; all wellness comes from here and is pushed
# into intervals.icu. Setup: scripts/google_auth.py
#
# One client, but TWO refresh tokens, and they must stay separate: the Google
# Health API rejects a token that also carries the calendar scope, 403ing every
# health call. Mint each with --scopes health / --scopes calendar.
GOOGLE_HEALTH_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_HEALTH_CLIENT_SECRET=...
GOOGLE_HEALTH_REFRESH_TOKEN=1//...
GOOGLE_CALENDAR_REFRESH_TOKEN=1//...
# Which calendars the coach reads, comma-separated. Default is the primary one
# alone; holiday and week-number feeds say nothing about training availability.
GOOGLE_CALENDAR_IDS=primary
# Must match the OAuth client byte for byte — Google compares it as a string, so
# https://google.com and https://www.google.com are different URIs. Only used
# during scripts/google_auth.py; nothing is served there.
GOOGLE_HEALTH_REDIRECT_URI=https://google.com

# --- Telegram ---
# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Your own numeric chat id (from @userinfobot). The bot ignores everyone else.
TELEGRAM_ALLOWED_CHAT_ID=123456789

# --- Vault ---
VAULT_REPO=git@github.com:you/triathlon-brain.git
VAULT_PATH=/vault
GIT_AUTHOR_NAME=tri-coach
GIT_AUTHOR_EMAIL=coach@localhost

# --- Schedule ---
DAILY_BRIEF_CRON_HOUR=6
DAILY_BRIEF_CRON_MINUTE=30
# Wellness sync runs this many minutes before the brief.
WELLNESS_SYNC_LEAD_MIN=15
TZ=Europe/Copenhagen
