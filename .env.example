# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
COACH_MODEL=claude-sonnet-5
PLANNER_MODEL=claude-opus-5

# --- intervals.icu ---
# Settings -> Developer Settings -> API Key
INTERVALS_API_KEY=...
INTERVALS_ATHLETE_ID=i123456

# --- Google (Fitbit Air -> HRV / resting HR / sleep / steps; calendar read) ---
# Coros supplies activities only; all wellness comes from here and is pushed
# into intervals.icu. Setup: scripts/google_auth.py
#
# One client, but TWO refresh tokens, and they must stay separate: the Google
# Health API rejects a token that also carries the calendar scope, 403ing every
# health call. Mint each with --scopes health / --scopes calendar.
GOOGLE_HEALTH_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_HEALTH_CLIENT_SECRET=...
GOOGLE_HEALTH_REFRESH_TOKEN=1//...
GOOGLE_CALENDAR_REFRESH_TOKEN=1//...
# Which calendars the coach reads, comma-separated. Default is the primary one
# alone; holiday and week-number feeds say nothing about training availability.
GOOGLE_CALENDAR_IDS=primary
# Must match the OAuth client byte for byte — Google compares it as a string, so
# https://google.com and https://www.google.com are different URIs. Only used
# during scripts/google_auth.py; nothing is served there.
GOOGLE_HEALTH_REDIRECT_URI=https://google.com

# --- Telegram ---
# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Your own numeric chat id (from @userinfobot). The bot ignores everyone else.
TELEGRAM_ALLOWED_CHAT_ID=123456789

# --- Vault ---
# In production this whole file lives at /opt/tri-coach/.env, mode 600, and is
# the single config surface — a change there needs a container restart. See
# deploy/README.md.
VAULT_REPO=git@github.com:you/triathlon-brain.git
VAULT_PATH=/vault
# Where the deploy key is mounted. deploy/docker-compose.yml mounts the secrets
# directory read-only at /mnt/secrets and entrypoint.sh copies the key out of it
# to somewhere it can chmod 600 — ssh refuses a group- or world-readable key.
VAULT_SSH_KEY_FILE=/mnt/secrets/id_ed25519
GIT_AUTHOR_NAME=tri-coach
GIT_AUTHOR_EMAIL=coach@localhost

# --- Schedule ---
# When the morning job starts polling for the night's wellness, not when it
# sends: it briefs as soon as HRV, resting HR and sleep are published.
DAILY_BRIEF_CRON_HOUR=6
DAILY_BRIEF_CRON_MINUTE=0
# ...and when it stops waiting and briefs anyway, saying what never arrived.
DAILY_BRIEF_DEADLINE_HOUR=9
DAILY_BRIEF_DEADLINE_MINUTE=0
# How often to re-check Google Health in between.
WELLNESS_POLL_INTERVAL_MIN=10
# When the evening debrief runs. A fixed time, and it sends then: it no longer
# waits for uploads, because each session is debriefed as it lands (see the
# webhook below). This job is the only writer of the daily note.
DAILY_DEBRIEF_CRON_HOUR=21
DAILY_DEBRIEF_CRON_MINUTE=0
TZ=Europe/Copenhagen

# --- intervals.icu webhook (ACTIVITY_UPLOADED -> session debrief) ---
# The shared secret intervals.icu puts in every webhook POST body. Find it on
# your app's page at https://intervals.icu/settings/apps.
#
# This is the on switch: with it unset the receiver opens no port at all and the
# bot behaves exactly as it did before webhooks — which is also what you want on
# a laptop, where nothing can reach you anyway. Never commit the real value.
INTERVALS_WEBHOOK_SECRET=
# Optional second check. Set the same value in "Webhook Authorization Header" on
# the app page and it is compared against the request's Authorization header.
# Leave empty to skip that check; the body secret above is verified regardless.
INTERVALS_WEBHOOK_AUTH_HEADER=
# Port the receiver listens on. Must match the port Caddy proxies to in
# deploy/Caddyfile and the container port in deploy/docker-compose.yml — they
# are three halves of one number.
WEBHOOK_PORT=8080
